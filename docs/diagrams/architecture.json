  "cards": [
    {
      "dot": "emerald",
      "title": "Request path",
      "items": [
        "loadgen sends checkout traffic through Envoy to api",
        "api reads Redis and Postgres, calls pricing, then writes to Kafka",
        "worker consumes orders and marks them done in Postgres"
      ]
    },
    {
      "dot": "rose",
      "title": "Fault loop",
      "items": [
        "control reads the active exercise from state.json",
        "Every 3 s it PUTs faults to every service and sets the api CPU limit",
        "A manual change is reverted on the next tick"
      ]
    },
    {
      "dot": "cyan",
      "title": "What you look at",
      "items": [
        "Prometheus scrapes /metrics on every service",
        "Every service sends spans to Tempo",
        "Grafana shows RED and USE dashboards and the traces",
        "An exemplar dot on a latency panel opens its trace"
      ]
    }
  ]
